{
  "name": "blast",
  "version": "0.1.0",
  "description": "Blast Radius for code deletions — see what breaks before you delete a file, directory, or export",
  "type": "module",
  "bin": {
    "blast": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.6",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "ignore": "^7.0.12"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "author": "Athalla Jovian Maharsa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JovianOps/blast.git"
  },
  "bugs": {
    "url": "https://github.com/JovianOps/blast/issues"
  },
  "homepage": "https://github.com/JovianOps/blast#readme"
}
